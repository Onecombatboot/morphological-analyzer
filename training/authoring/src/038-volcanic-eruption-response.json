 "characterisations": {
  "Effusive lava flow": {
   "requires": "low-viscosity magma reaching the surface",
   "provides": "slow predictable advance, days of warning, no ash column, destruction of anything in the path"
  },
  "Explosive ash column": {
   "requires": "gas-rich magma fragmenting at the vent",
   "provides": "regional ash fall, aviation hazard, no lava flow"
  },
  "Pyroclastic density current": {
   "requires": "column collapse or dome failure",
   "provides": "lethal within minutes, no survivable shelter in the path, very short warning"
  },
  "Lahar in a river valley": {
   "requires": "loose ash plus water on a slope",
   "provides": "flow confined to valleys, travel far beyond the volcano, hours of transit time"
  },
  "Seismic swarm": {
   "requires": "instruments on the edifice",
   "provides": "indication of magma movement, days to weeks of lead, no eruption style information"
  },
  "Ground deformation": {
   "requires": "geodetic instruments in place",
   "provides": "evidence of inflation, weeks to months of lead, no timing precision"
  },
  "Gas emission change": {
   "requires": "sampling or remote spectroscopy",
   "provides": "indication of magma degassing, no location detail"
  },
  "No instrumentation present": {
   "requires": "an unmonitored volcano",
   "provides": "no warning of any kind"
  },
  "Town on the flank": {
   "requires": "settlement within the hazard zone",
   "provides": "life safety governing, evacuation feasible with warning"
  },
  "Aviation routes overhead": {
   "requires": "flight paths crossing the plume",
   "provides": "aircraft at risk from ash, no ground exposure"
  },
  "Downstream river settlements": {
   "requires": "communities along the drainage",
   "provides": "exposure only to flows following valleys, distance from the vent"
  },
  "Uninhabited wilderness": {
   "requires": "no population or infrastructure",
   "provides": "no consequence beyond the landscape"
  },
  "Phased evacuation": {
   "requires": "warning time and usable routes",
   "provides": "population removed before arrival, economic and social cost"
  },
  "Airspace closure": {
   "requires": "an aviation authority and plume forecasts",
   "provides": "aircraft kept clear, no effect on the ground"
  },
  "Engineered flow diversion": {
   "requires": "channels or barriers built in advance",
   "provides": "redirection of a surface flow, useless against an airborne hazard"
  },
  "Shelter in place": {
   "requires": "buildings able to exclude the hazard",
   "provides": "protection from ash fall, no protection from any flow"
  }
 },
