{
 "domain": "hospital cyber incident affecting care",
 "group": "cyber",
 "parameters": {
  "SYSTEM AFFECTED": [
   "Electronic patient record",
   "Diagnostic imaging archive",
   "Laboratory information system",
   "Networked infusion devices"
  ],
  "ATTACK EFFECT": [
   "Encryption of data at rest",
   "Silent alteration of records",
   "Denial of network access",
   "Exfiltration without disruption"
  ],
  "CLINICAL MITIGATION": [
   "Paper downtime procedures",
   "Divert emergency admissions",
   "Cancel elective activity",
   "Manual device operation"
  ],
  "PATIENT CONSEQUENCE": [
   "No clinical impact",
   "Delayed diagnosis or treatment",
   "Incorrect treatment given",
   "Death attributable to the incident"
  ]
 },
 "characterisations": {
  "Electronic patient record": {
   "requires": "the central clinical record system",
   "provides": "loss of history, allergies and current orders, every department affected at once"
  },
  "Diagnostic imaging archive": {
   "requires": "the store and viewer for radiology",
   "provides": "images unavailable for reporting, no effect on acquisition itself"
  },
  "Laboratory information system": {
   "requires": "the analyser and results pipeline",
   "provides": "no results returned, specimens still collectable"
  },
  "Networked infusion devices": {
   "requires": "bedside pumps with a management link",
   "provides": "direct patient harm potential, device-level rather than record-level"
  },
  "Encryption of data at rest": {
   "requires": "ransomware reaching the storage",
   "provides": "total unavailability, recovery from backup possible"
  },
  "Silent alteration of records": {
   "requires": "write access without detection",
   "provides": "data present but untrustworthy, no obvious outage"
  },
  "Denial of network access": {
   "requires": "saturation or segmentation failure",
   "provides": "systems intact but unreachable, immediate restoration once cleared"
  },
  "Exfiltration without disruption": {
   "requires": "outbound copying of data",
   "provides": "confidentiality loss only, care unaffected"
  },
  "Paper downtime procedures": {
   "requires": "pre-printed forms and trained staff",
   "provides": "continuity of documentation, no access to prior history"
  },
  "Divert emergency admissions": {
   "requires": "another receiving hospital with capacity",
   "provides": "reduced load, transfer risk to patients"
  },
  "Cancel elective activity": {
   "requires": "a schedule that can be postponed",
   "provides": "capacity freed for urgent care, no benefit to anyone already mid-treatment"
  },
  "Manual device operation": {
   "requires": "devices usable without the network",
   "provides": "continued treatment, heavy staffing cost"
  },
  "No clinical impact": {
   "requires": "containment before any care is affected",
   "provides": "no consequence"
  },
  "Delayed diagnosis or treatment": {
   "requires": "care postponed rather than wrong",
   "provides": "harm from delay only"
  },
  "Incorrect treatment given": {
   "requires": "a clinician acting on wrong information",
   "provides": "direct iatrogenic harm"
  },
  "Death attributable to the incident": {
   "requires": "harm severe enough to be causal",
   "provides": "mortality, regulatory and criminal exposure"
  }
 },
